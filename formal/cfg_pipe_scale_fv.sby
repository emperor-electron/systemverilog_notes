[tasks]
travel
quiesce
cover

[options]
travel:  mode bmc
travel:  depth 7
quiesce: mode bmc
quiesce: depth 7
cover:   mode cover
cover:   depth 12

[engines]
smtbmc boolector

[script]
read_verilog -sv -formal -DSYNTHESIS -DFORMAL cfg_pkg.sv
read_verilog -sv -formal -DSYNTHESIS -DFORMAL pipe_ctrl.sv
read_verilog -sv -formal -DSYNTHESIS -DFORMAL csr_shadow.sv
read_verilog -sv -formal -DSYNTHESIS -DFORMAL cfg_pipe_scale.sv
read_verilog -sv -formal -DSYNTHESIS -DFORMAL cfg_pipe_scale_fv.sv
travel:  chparam -set CFG_MODE 2 cfg_pipe_scale_fv
quiesce: chparam -set CFG_MODE 1 cfg_pipe_scale_fv
cover:   chparam -set CFG_MODE 2 cfg_pipe_scale_fv
prep -top cfg_pipe_scale_fv

[files]
../examples/rtl/cfg_pkg.sv
../examples/rtl/pipe_ctrl.sv
../examples/rtl/csr_shadow.sv
../examples/rtl/cfg_pipe_scale.sv
cfg_pipe_scale_fv.sv
