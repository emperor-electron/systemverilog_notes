[tasks]
bmc
prove
cover

[options]
bmc:   mode bmc
bmc:   depth 20
prove: mode prove
cover: mode cover
cover: depth 20

[engines]
smtbmc boolector

[script]
read_verilog -sv -formal -DSYNTHESIS -DFORMAL cdc_bit.sv
read_verilog -sv -formal -DSYNTHESIS -DFORMAL cdc_handshake.sv
read_verilog -sv -formal -DSYNTHESIS -DFORMAL cdc_handshake_fv.sv
prep -top cdc_handshake_fv

[files]
../examples/rtl/cdc_bit.sv
../examples/rtl/cdc_handshake.sv
cdc_handshake_fv.sv
