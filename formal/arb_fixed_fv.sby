# Exhaustive proof of the fixed-priority arbiter.
# Combinational, so depth 1 covers the entire input space.
[tasks]
bmc
cover

[options]
bmc:   mode bmc
bmc:   depth 2
cover: mode cover
cover: depth 2

[engines]
smtbmc boolector

[script]
read_verilog -sv -formal -DSYNTHESIS -DFORMAL arb_fixed.sv
read_verilog -sv -formal -DSYNTHESIS -DFORMAL arb_fixed_fv.sv
prep -top arb_fixed_fv

[files]
../examples/rtl/arb_fixed.sv
arb_fixed_fv.sv
