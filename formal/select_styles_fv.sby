[tasks]
bmc
cover

[options]
# Combinational: one step is the whole input space. No induction to close.
bmc:   mode bmc
bmc:   depth 1
cover: mode cover
cover: depth 1

[engines]
smtbmc boolector

[script]
read_verilog -sv -formal -DSYNTHESIS -DFORMAL select_styles.sv
read_verilog -sv -formal -DSYNTHESIS -DFORMAL select_styles_fv.sv
prep -top select_styles_fv

[files]
../examples/rtl/select_styles.sv
select_styles_fv.sv
