[tasks]
bmc
prove
cover

[options]
bmc:   mode bmc
bmc:   depth 24
prove: mode prove
cover: mode cover
cover: depth 24

[engines]
smtbmc boolector

[script]
read_verilog -sv -formal -DSYNTHESIS -DFORMAL pwm.sv
read_verilog -sv -formal -DSYNTHESIS -DFORMAL pwm_fv.sv
prep -top pwm_fv

[files]
../examples/rtl/pwm.sv
pwm_fv.sv
